#!/usr/bin/env bash
# sf-task-brief — extract one implementation unit's section from a plan file.
#
# Usage: sf-task-brief <plan-file> <U-ID>
#   e.g. sf-task-brief docs/plans/2026-07-03-001-...-plan.md U3
#
# Prints just the requested unit's section — from its `### U<N>.` heading up to
# (but not including) the next `### U` heading, or end-of-file. The point is a
# bounded, fresh brief for a dispatched subagent instead of a stale paste of the
# whole plan. Mirrors the spirit of Superpowers' `task-brief`.
set -euo pipefail

usage() {
  echo "usage: sf-task-brief <plan-file> <U-ID>" >&2
  echo "  e.g. sf-task-brief docs/plans/foo-plan.md U3" >&2
}

if [ "$#" -ne 2 ]; then
  usage
  exit 1
fi

plan_file="$1"
uid="$2"

if [ ! -f "$plan_file" ]; then
  echo "error: plan file not found: $plan_file" >&2
  exit 1
fi

# Normalize the U-ID: accept "U3", "u3", or bare "3".
uid="${uid#[Uu]}"
if ! printf '%s' "$uid" | grep -Eq '^[0-9]+$'; then
  echo "error: invalid U-ID '$2' (expected e.g. U3)" >&2
  exit 1
fi

# Extract from `### U<N>.` to the next `### U` heading (or EOF).
section="$(
  awk -v want="$uid" '
    /^### U[0-9]+\./ {
      # Parse the unit number out of the heading.
      hdr = $0
      sub(/^### U/, "", hdr)
      sub(/\..*$/, "", hdr)
      if (hdr == want) { grabbing = 1; print; next }
      if (grabbing) { grabbing = 0 }
    }
    grabbing { print }
  ' "$plan_file"
)"

if [ -z "$section" ]; then
  echo "error: unit U$uid not found in $plan_file" >&2
  exit 1
fi

printf '%s\n' "$section"
